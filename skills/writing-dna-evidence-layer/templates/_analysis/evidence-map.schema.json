{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Writing DNA Evidence Map",
  "type": "object",
  "required": [
    "generated_at",
    "claims"
  ],
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "layer",
          "source_type",
          "sources",
          "confidence"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "layer": {
            "enum": [
              "L1",
              "L2",
              "L3",
              "L4",
              "L5",
              "L6"
            ]
          },
          "source_type": {
            "enum": [
              "raw",
              "meta",
              "script",
              "distilled",
              "mixed"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "unverified"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
